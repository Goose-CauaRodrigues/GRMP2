<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GRMP</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Geral.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GRMP.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- ===== Header SENAI ===== -->
    <header class="senai-header">
        <div class="brand">
            <span class="senai-badge">SENAI</span>
            <h1>Gestão de Recursos e Manutenção Predial</h1>
        </div>
        <nav style="display:flex; align-items:center; gap:10px;">
            @{
                string id = Context.Session.GetString("idUsuario");
                string nv = Context.Session.GetString("nvAcesso");
            }
            @{
                if (nv == "2" || nv == "3")
                {
                    <a asp-controller="Mapa"
                       asp-action="MapaExibir"
                       style="
                        text-decoration:none;
                        color:white;
                        font-size:14px;
                        font-weight:600;
                        padding:10px 16px;
                        border-radius:8px;
                        transition:0.2s;
                        display:inline-block;
                        ">
                        Mapa
                    </a>
                }
                <a asp-controller="OrdemServico"
                   asp-action="ListarOSExibir"
                   style="
                    text-decoration:none;
                    color:white;
                    font-size:14px;
                    font-weight:600;
                    padding:10px 16px;
                    border-radius:8px;
                    transition:0.2s;
                    display:inline-block;
                    ">
                    Ordens de Serviço
                </a>
                if (id == "1")
                {
                    <a asp-controller="GerenciarUsuarios"
                       asp-action="ListaUsuariosExibir"
                       style="
                        text-decoration:none;
                        color:white;
                        font-size:14px;
                        font-weight:600;
                        padding:10px 16px;
                        border-radius:8px;
                        transition:0.2s;
                        display:inline-block;
                        ">
                        Usuários
                    </a>
                }

                
                if (nv == "3")
                {
                    <a asp-controller="Dashboard"
                       asp-action="DashboardExibir"
                       style="
                        text-decoration:none;
                        color:white;
                        font-size:14px;
                        font-weight:600;
                        padding:10px 16px;
                        border-radius:8px;
                        transition:0.2s;
                        display:inline-block;
                        ">
                        Relatório
                    </a>
                }
                                
                <a asp-controller="GerenciarUsuarios"
                   asp-action="AlterarSenhaExibir"
                   style="
                    text-decoration:none;
                    color:white;
                    font-size:14px;
                    font-weight:600;
                    padding:10px 16px;
                    border-radius:8px;
                    transition:0.2s;
                    display:inline-block;
                    ">
                    Minha Conta
                </a>

                <a asp-controller="Login"
                   asp-action="SairProcessar"
                   style="
                    text-decoration:none;
                    color:white;
                    font-size:14px;
                    font-weight:600;
                    padding:10px 16px;
                    border-radius:8px;
                    transition:0.2s;
                    display:inline-block;
                    ">
                    Sair
                </a>
            }
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <footer class="relative overflow-hidden">
        <!-- glow background -->
        <div aria-hidden class="pointer-events-none absolute inset-0" style="background: var(--gradient-radial)"></div>
        <div aria-hidden class="pointer-events-none absolute top-0 left-0 right-0 h-px"
             style="background: linear-gradient(90deg, transparent, var(--primary), transparent)"></div>

        <div class="relative mx-auto max-w-7xl px-6 pb-10 pt-20 lg:px-10">

            <!-- Brand row -->
            <div class="pb-14" style="border-bottom: 1px solid var(--footer-border)">
                <div class="flex items-center gap-3">
                    <div class="flex h-11 w-11 items-center justify-center rounded-xl gradient-primary">
                        <i data-lucide="flame" class="w-5 h-5 text-white"></i>
                    </div>
                    <span class="text-2xl font-bold tracking-tight">SENAI</span>
                </div>
                <h2 class="mt-6 max-w-2xl text-4xl md:text-5xl font-bold leading-[1.05] tracking-tight">
                    Educação que <span class="italic text-danger">transforma</span> o futuro da indústria.
                </h2>
                <p class="mt-4 max-w-xl text-base">
                    Formando profissionais qualificados para os desafios da indústria brasileira há mais de 80 anos.
                </p>
            </div>

            <!-- Link grid -->
            @* <div class="grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">

                <div>
                    <h3 class="text-xs font-semibold uppercase tracking-[0.2em]">Produto</h3>
                    <ul class="mt-5 space-y-3 text-sm text-muted">
                        <li><a href="#" class="link-underline">Recursos</a></li>
                        <li><a href="#" class="link-underline">Integrações</a></li>
                        <li><a href="#" class="link-underline">Preços</a></li>
                        <li><a href="#" class="link-underline">Novidades</a></li>
                        <li><a href="#" class="link-underline">Roadmap</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-xs font-semibold uppercase tracking-[0.2em]">Empresa</h3>
                    <ul class="mt-5 space-y-3 text-sm text-muted">
                        <li><a href="#" class="link-underline">Sobre nós</a></li>
                        <li><a href="#" class="link-underline">Carreiras</a></li>
                        <li><a href="#" class="link-underline">Imprensa</a></li>
                        <li><a href="#" class="link-underline">Parceiros</a></li>
                        <li><a href="#" class="link-underline">Contato</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-xs font-semibold uppercase tracking-[0.2em]">Recursos</h3>
                    <ul class="mt-5 space-y-3 text-sm text-muted">
                        <li><a href="#" class="link-underline">Blog</a></li>
                        <li><a href="#" class="link-underline">Documentação</a></li>
                        <li><a href="#" class="link-underline">Comunidade</a></li>
                        <li><a href="#" class="link-underline">Suporte</a></li>
                        <li><a href="#" class="link-underline">Status</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-xs font-semibold uppercase tracking-[0.2em]">Legal</h3>
                    <ul class="mt-5 space-y-3 text-sm text-muted">
                        <li><a href="#" class="link-underline">Privacidade</a></li>
                        <li><a href="#" class="link-underline">Termos</a></li>
                        <li><a href="#" class="link-underline">Cookies</a></li>
                        <li><a href="#" class="link-underline">Licenças</a></li>
                        <li><a href="#" class="link-underline">Segurança</a></li>
                    </ul>
                </div>
            </div> *@

            <!-- Bottom bar -->
            <div class="flex flex-col items-start justify-between gap-6 pt-8 md:flex-row md:items-center"
                 style="border-top: 1px solid var(--footer-border)">
                <p class="text-xs">© 2026 SENAI. Todos os direitos reservados.</p>

                <div class="flex items-center gap-2 text-xs">
                    <span class="h-1.5 w-1.5 rounded-full bg-primary pulse"></span>
                    Todos os sistemas operacionais
                </div>
            </div>
        </div>

        <!-- Giant brand text -->
        <div aria-hidden class="select-none overflow-hidden text-center font-bold leading-none tracking-tighter"
             style="font-size: clamp(5rem, 22vw, 18rem);
            background: linear-gradient(180deg, rgba(214,40,40,0.25), transparent 80%);
            -webkit-background-clip: text; background-clip: text;
            -webkit-text-fill-color: transparent;">
            SENAI
        </div>
    </footer>

    <script>lucide.createIcons();</script>
</body>
</html>

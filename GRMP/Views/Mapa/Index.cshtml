@model List<string>
@{
    ViewData["Title"] = "Mapa";
}

<style>
    .map-wrapper {
        display: flex;
        gap: 20px;
        padding: 20px;
    }

    .map-area {
        position: relative;
        width: 1000px;
        flex-shrink: 0;
    }

        .map-area img {
            width: 100%;
            border-radius: 12px;
            border: 1px solid #ccc;
            display: block;
        }

    .bloco {
        position: absolute;
        cursor: pointer;
        /* cobre toda a área — o clip-path define a forma real */
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        transition: .2s;
    }

        .bloco:hover {
            background: rgba(37,99,235,.18);
        }

    .pin {
        position: absolute;
        width: 18px;
        height: 18px;
        background: red;
        border-radius: 50% 50% 50% 0;
        transform: rotate(-45deg);
        animation: pulse 1.5s infinite;
    }

        .pin::after {
            content: '';
            width: 8px;
            height: 8px;
            background: white;
            position: absolute;
            top: 5px;
            left: 5px;
            border-radius: 50%;
        }

    @@keyframes pulse {
        0% {
            transform: rotate(-45deg) scale(1);
        }

        50% {
            transform: rotate(-45deg) scale(1.15);
        }

        100% {
            transform: rotate(-45deg) scale(1);
        }
    }

    .side-panel {
        width: 280px;
        background: white;
        border-radius: 12px;
        border: 1px solid #ddd;
        padding: 20px;
        height: fit-content;
    }

    .legend {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 10px;
    }

        .legend .dot {
            width: 16px;
            height: 16px;
            background: red;
            border-radius: 50%;
        }
</style>

<div class="map-wrapper">
    <div class="map-area" id="mapaContainer">
        <img src="~/img/mapa.png" alt="Mapa SENAI" />

        <!-- BLOCO A -->
        <a asp-controller="Mapa" asp-action="Bloco" asp-route-id="1">

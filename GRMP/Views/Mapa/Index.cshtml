@model GRMP.Models.MapaViewModel
@{
    ViewData["Title"] = "Mapa";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · SENAI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
    <link href="~/css/Mapa.css" rel="stylesheet" />
</head>
<body>

    <!-- ===== Header SENAI ===== -->
    <header class="senai-header">
        <div class="brand">
            <span class="senai-badge">SENAI</span>
            <h1>Mapa de Manutenção Predial</h1>
        </div>
        <nav style="display:flex; align-items:center; gap:10px;">

            <a asp-controller="Mapa"
               asp-action="Index"
               style="
                text-decoration:none;
                color:white;
                font-size:14px;
                font-weight:600;
                padding:10px 16px;
                border-radius:8px;
                transition:0.2s;
                display:inline-block;
                ">
                Mapa
            </a>

            <a asp-controller="Usuario"
               asp-action="InicioExibir"
               style="
                text-decoration:none;
                color:white;
                font-size:14px;
                font-weight:600;
                padding:10px 16px;
                border-radius:8px;
                transition:0.2s;
                display:inline-block;
                ">
                Início
            </a>

            <a asp-controller="Dashboard"
               asp-action="Index"
               style="
                text-decoration:none;
                color:white;
                font-size:14px;
                font-weight:600;
                padding:10px 16px;
                border-radius:8px;
                transition:0.2s;
                display:inline-block;
                ">
                Relatório
            </a>

        </nav>
    </header>

    

    <!-- ===== Layout principal ===== -->
    <main class="map-wrapper">

        <!-- ===== Área do mapa ===== -->
        <div class="map-area" id="mapaContainer">
            <img src="~/img/mapa.png" alt="Mapa aéreo das instalações do SENAI" />

            <!-- BLOCO A
                 A <a> cobre todo o mapa (position absolute inset 0 pointer-events none).
                 O .bloco tem o clip-path e pointer-events all — só a área do polígono recebe clique. -->
            <!-- BLOCO A -->
            <a asp-controller="Mapa" asp-action="Bloco" asp-route-id="Bloco A" title="Bloco A">
                <div class="bloco"
                     style="clip-path: polygon(42.1% 14.3%, 22.0% 88.6%, 12.6% 80.4%, 32.5% 7.1%);">
                </div>
            </a>
            @if (Model.BlocosComOs.Contains("Bloco A"))
            {
                <div class="pin" style="top:44.3%; left:27%;"></div>
            }

            <!-- BLOCO B -->
            <a asp-controller="Mapa" asp-action="Bloco" asp-route-id="Bloco B" title="Bloco B">
                <div class="bloco"
                     style="clip-path: polygon(52.1% 67.9%, 44.3% 94.6%, 35.9% 87.2%, 44.2% 60.0%);">
                </div>
            </a>
            @if (Model.BlocosComOs.Contains("Bloco B"))
            {
                <div class="pin" style="top:72.5%; left:44.3%;"></div>
            }

            <!-- BLOCO C -->
            <a asp-controller="Mapa" asp-action="Bloco" asp-route-id="Bloco C" title="Bloco C">
                <div class="bloco"
                     style="clip-path: polygon(54.9% 58.6%, 37.1% 42.7%, 34.3% 51.1%, 52.1% 67.7%);">
                </div>
            </a>
            @if (Model.BlocosComOs.Contains("Bloco C"))
            {
                <div class="pin" style="top:53.5%; left:44.7%;"></div>
            }

            <!-- BLOCO D -->
            <a asp-controller="Mapa" asp-action="Bloco" asp-route-id="Bloco D" title="Bloco D">
                <div class="bloco"
                     style="clip-path: polygon(55.7% 51.3%, 66.0% 16.7%, 53.6% 6.2%, 42.9% 40.3%);">
                </div>
            </a>
            @if (Model.BlocosComOs.Contains("Bloco D"))
            {
                <div class="pin" style="top:25.8%; left:54.9%;"></div>
            }

            <!-- BLOCO E -->
            <a asp-controller="Mapa" asp-action="Bloco" asp-route-id="Bloco E" title="Bloco E">
                <div class="bloco"
                     style="clip-path: polygon(68.7% 27.3%, 74.9% 33.1%, 66.6% 61.0%, 59.9% 55.4%);">
                </div>
            </a>
            @if (Model.BlocosComOs.Contains("Bloco E"))
            {
                <div class="pin" style="top:41.7%; left:68%;"></div>
            }

            <!-- BLOCO F -->
            <a asp-controller="Mapa" asp-action="Bloco" asp-route-id="Bloco F" title="Bloco F">
                <div class="bloco"
                     style="clip-path: polygon(55.2% 73.0%, 58.2% 62.6%, 76.6% 78.3%, 73.5% 89.3%);">
                </div>
            </a>
            @if (Model.BlocosComOs.Contains("Bloco F"))
            {
                <div class="pin" style="top:72.9%; left:65.7%;"></div>
            }

            <!-- BLOCO G -->
            <a asp-controller="Mapa" asp-action="Bloco" asp-route-id="Bloco G" title="Bloco G">
                <div class="bloco"
                     style="clip-path: polygon(72.7% 56.4%, 83.7% 65.8%, 81.2% 73.7%, 70.3% 64.6%);">
                </div>
            </a>
            @if (Model.BlocosComOs.Contains("Bloco G"))
            {
                <div class="pin" style="top:63.1%; left:77.7%;"></div>
            }

            <!-- BLOCO H -->
            <a asp-controller="Mapa" asp-action="Bloco" asp-route-id="Bloco H" title="Bloco H">
                <div class="bloco"
                     style="clip-path: polygon(82.6% 43.9%, 92.9% 52.1%, 88.8% 67.0%, 78.1% 58.1%);">
                </div>
            </a>
            @if (Model.BlocosComOs.Contains("Bloco H"))
            {
                <div class="pin" style="top:50.6%; left:85.4%;"></div>
            }

            <!-- DEPÓSITO ALMOXARIFADO -->
            <a asp-controller="Mapa" asp-action="Bloco" asp-route-id="DEP_ALMO" title="Depósito Almoxarifado">
                <div class="bloco"
                     style="clip-path: polygon(14.6% 7.1%, 16.6% 7.1%, 16.7% 11.2%, 14.5% 11.0%);">
                </div>
            </a>
            @if (Model.BlocosComOs.Contains("DEP_ALMO"))
            {
                <div class="pin" style="top:6.3%; left:15.5%;"></div>
            }

            <!-- DEPÓSITO QUÍMICO -->
            <a asp-controller="Mapa" asp-action="Bloco" asp-route-id="DEP_QUIM" title="Depósito Químico">
                <div class="bloco"
                     style="clip-path: polygon(23.3% 7.1%, 25.9% 9.0%, 25.2% 12.4%, 22.4% 10.7%);">
                </div>
            </a>
            @if (Model.BlocosComOs.Contains("DEP_QUIM"))
            {
                <div class="pin" style="top:7.5%; left:24.5%;"></div>
            }

            <!-- RESTAURANTE / VESTIÁRIO -->
            <a asp-controller="Mapa" asp-action="Bloco" asp-route-id="REST" title="Restaurante / Vestiário">
                <div class="bloco"
                     style="clip-path: polygon(96.8% 15.0%, 99.0% 17.0%, 95.8% 27.8%, 93.3% 26.6%);">
                </div>
            </a>
            @if (Model.BlocosComOs.Contains("REST"))
            {
                <div class="pin" style="top:18.8%; left:96.6%;"></div>
            }

            <!-- SERVIÇOS -->
            <a asp-controller="Mapa" asp-action="Bloco" asp-route-id="SERV" title="Serviços">
                <div class="bloco"
                     style="clip-path: polygon(59.6% 87.4%, 57.7% 85.7%, 54.3% 97.3%, 56.3% 98.7%);">
                </div>
            </a>
            @if (Model.BlocosComOs.Contains("SERV"))
            {
                <div class="pin" style="top:89.5%; left:57.1%;"></div>
            }

        </div>
        <!-- /map-area -->
        <!-- ===== Painel lateral ===== -->
        <aside class="side-panel">
            <h3>Mapa Interativo</h3>
            <p>Clique em um bloco para visualizar os locais e salas.</p>

            <div class="tabs">

                <a asp-action="Index"
                   class="@(Model.StatusSelecionado == null ? "active" : "")">
                    Todos
                </a>

                <a asp-action="Index"
                   asp-route-status="1"
                   class="@(Model.StatusSelecionado == 1 ? "active" : "")">
                    Abertos
                </a>

                <a asp-action="Index"
                   asp-route-status="2"
                   class="@(Model.StatusSelecionado == 2 ? "active" : "")">
                    Em andamento
                </a>

                <a asp-action="Index"
                   asp-route-status="3"
                   class="@(Model.StatusSelecionado == 3 ? "active" : "")">
                    Resolvidos
                </a>

            </div>

            @foreach (var chamado in Model.Chamados)
            {
                <div class="chamado-card">

                    <div class="top">
                        <span class="id">#@chamado.Id</span>

                        <span class="status-badge
                            @(chamado.Status == 1 || chamado.Status == 0 ? "aberto" :
                                chamado.Status == 2 ? "andamento" : "resolvido")">

                            @chamado.StatusTexto
                        </span>
                    </div>

                    <p class="titulo">@chamado.Titulo</p>

                    <p class="meta">@chamado.Bloco</p>

                </div>
            }

        </aside>
        <!-- /side-panel -->

    </main>

</body>
</html>

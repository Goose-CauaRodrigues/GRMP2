@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Usuários";

    Layout = null;
}

<link href="~/css/ListaUsuario.css" rel="stylesheet" />

<!-- ===== Header ===== -->
<header class="senai-header">
    <div class="brand">
        <span class="senai-badge">SENAI</span>
        <h1>Mapa de Manutenção Predial</h1>
    </div>
    <nav style="display:flex; align-items:center; gap:10px;">

        <a asp-controller="Mapa"
           asp-action="Index"
           style="
            text-decoration:none;
            color:white;
            font-size:14px;
            font-weight:600;
            padding:10px 16px;
            border-radius:8px;
            transition:0.2s;
            display:inline-block;
            ">
            Mapa
        </a>

        <a asp-controller="Usuario"
           asp-action="InicioExibir"
           style="
            text-decoration:none;
            color:white;
            font-size:14px;
            font-weight:600;
            padding:10px 16px;
            border-radius:8px;
            transition:0.2s;
            display:inline-block;
            ">
            Início
        </a>

        <a asp-controller="GerenciarUsuarios"
           asp-action="ListaUsuariosExibir"
           style="
            text-decoration:none;
            color:white;
            font-size:14px;
            font-weight:600;
            padding:10px 16px;
            border-radius:8px;
            transition:0.2s;
            display:inline-block;
            ">
            Usuarios
        </a>

        <a asp-controller="Dashboard"
           asp-action="Index"
           style="
            text-decoration:none;
            color:white;
            font-size:14px;
            font-weight:600;
            padding:10px 16px;
            border-radius:8px;
            transition:0.2s;
            display:inline-block;
            ">
            Relatório
        </a>

    </nav>
</header>

<div class="container">

    <div class="page-header">
        <div class="page-header-top">
            <div>
                <h2>Usuários Registrados</h2>
                <p>Visualização de usuários do sistema</p>
            </div>
            <button type="button"
                    class="botao-adicionar"
                    onclick="window.location.href='@Url.Action("CriarUsuarioExibir", "GerenciarUsuarios")'">
                Adicionar Usuário
            </button>
        </div>
    </div>

    <div class="historico">

        @if (Model == null || Model.Rows.Count == 0)
        {
            <div class="empty-state">
                <div class="icon">📭</div>
                <p>Nenhum usuário encontrado.</p>
            </div>
        }
        else
        {
            @foreach (DataRow c in Model.Rows)
            {
                // =========================
                // NÍVEL DE ACESSO
                // =========================
                int acessoValor = c["nvAcesso"] != DBNull.Value
                    ? Convert.ToInt32(c["nvAcesso"])
                    : -1;

                string nivelAcesso = acessoValor switch
                {
                    1 => "Usuário",
                    3 => "Administrador",
                    2 => "Funcionario"
                };

                string statusClass = acessoValor switch
                {
                    3 => "admin",
                    1 => "usuario",
                    _ => ""
                };

                <div class="card-chamado">

                    <div class="card-top">
                        <strong>@c["nome"]</strong>
                        <span class="status @statusClass">@nivelAcesso</span>
                    </div>

                    <div class="detalhes">
                        <p>
                            <strong>Nome:</strong><br>
                            @c["nome"]
                        </p>
                        <p>
                            <strong>Email:</strong><br>
                            @c["Email"]
                        </p>
                        <p>
                            <strong>Nível de Acesso:</strong><br>
                            @nivelAcesso
                        </p>
                    </div>

                    <div class="card-actions">
                        <button type="button"
                                class="botao-gerenciar"
                                onclick="window.location.href='@Url.Action("AlterarUsuarioExibir", "GerenciarUsuarios", new { id = c["idUsuario"] })'">
                            Gerenciar
                        </button>
                    </div>

                </div>
            }
        }

    </div>
</div>
@model UsuarioViewModel

@{
    ViewData["Title"] = "Novo Usuário";
}
@{
    Layout = null;
}

<link rel="stylesheet" href="~/css/UsuarioCriar.css" />

<div class="container-os">

    <div class="header-pagina">

        <div>
            <h1>Novo Usuário</h1>
            <p>Registrar um novo usuário no sistema</p>
        </div>

        <a href="@Url.Action("ListaUsuariosExibir", "GerenciarUsuarios")"
           class="btn-voltar">

            Voltar

        </a>

    </div>

    <form asp-action="CriarUsuarioProcessar"
          asp-controller="GerenciarUsuarios"
          method="post"
          class="card-formulario">

        <!-- NOME -->
        <div class="grupo-form">

            <label asp-for="Nome">
                Nome
            </label>

            <input type="text"
                   asp-for="Nome"
                   placeholder="Digite o nome do usuário" required/>

        </div>

        <!-- EMAIL -->
        <div class="grupo-form">

            <label asp-for="Email">
                Email
            </label>

            <input type="email"
                   asp-for="Email"
                   placeholder="Digite o email" required />

        </div>

        <!-- SENHA -->
        <div class="grupo-form">

            <label asp-for="Senha">
                Senha
            </label>

            <input type="password"
                   asp-for="Senha"
                   value="Senha123" readonly required />

        </div>

        <!-- NÍVEL DE ACESSO -->
        <div class="grupo-form">

            <label asp-for="NvAcesso">
                Nível de Acesso
            </label>

            <select asp-for="NvAcesso" required>

                <option value="">
                    Selecione
                </option>

                <option value="3">
                    Administrador
                </option>

                <option value="2">
                    Técnico
                </option>

                <option value="1">
                    Usuário
                </option>

            </select>

        </div>

        <!-- BOTÃO -->
        <div class="acoes-form">

            <button type="submit"
                    class="btn-salvar">

                Criar Usuário

            </button>

        </div>

    </form>

</div>
@model GRMP.Models.LoginViewModel;

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SENAI - Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="~/css/Login.css" rel="stylesheet" />
</head>
<body>
 
    <div class="container">
 
        <div class="left">
            <div class="logo-badge"><span>SENAI</span></div>
            <h1>Gerenciamento de<br>Recursos e<br>Manutenção<br>Predial</h1>
        </div>
 
        <div class="card">
            <h2>ENTRAR</h2>
            <p class="subtitle">Utilize seu login educacional para acessar o sistema</p>
            <form asp-controller="Login" asp-action="LoginProcessar" method="post">
                <div class="field">
                    <label asp-for="Email">Digite seu Email</label>
                    <input asp-for="Email" type="email" autocomplete="username" placeholder="Exemplo@gmail.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="Senha">Digite sua senha</label>
                    <input asp-for="Senha" type="password" autocomplete="current-password" placeholder="Senha123" />
                    <span asp-validation-for="Senha" class="text-danger"></span>
               </div>
 
            <button class="btn" type="submit">
                Entrar
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </button>
            </form>
        </div>
 
    </div>
 

 
</body>
</html>











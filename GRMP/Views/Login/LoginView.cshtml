<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SENAI - Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="~/css/Login.css" rel="stylesheet" />
</head>
<body>
 
    <div class="container">
 
        <div class="left">
            <div class="logo-badge"><span>SENAI</span></div>
            <h1>Gerenciamento de<br>Recursos e<br>Manutenção<br>Predial</h1>
        </div>
 
        <div class="card">
            <h2>ENTRAR</h2>
            <p class="subtitle">Utilize seu login educacional para acessar o sistema</p>
 
            <div class="field">
                <label for="usuario">Digite seu usuario</label>
                <input id="usuario" type="text" placeholder="Elias Silva" autocomplete="username" />
            </div>
 
            <div class="field">
                <label for="senha">Digite sua senha</label>
                <input id="senha" type="password" placeholder="Senha.Exemplo123!" autocomplete="current-password" />
            </div>
 
            <button class="btn" onclick="handleLogin()">
                Entrar
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </button>
        </div>
 
    </div>
 
    <script>
            function handleLogin() {
              const usuario = document.getElementById('usuario').value.trim();
              const senha   = document.getElementById('senha').value.trim();
              if (!usuario || !senha) { alert('Preencha usuário e senha.'); return; }
              console.log('Login:', { usuario, senha });
            }
 
            document.getElementById('senha').addEventListener('keydown', e => {
              if (e.key === 'Enter') handleLogin();
            });
    </script>
 
</body>
</html>











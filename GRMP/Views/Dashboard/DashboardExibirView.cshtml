@model GRMP.Models.DashboardViewModel
@using System.Linq

@{
    ViewData["Title"] = "Dashboard OS · SENAI";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
<link href="~/css/Dashboard.css" rel="stylesheet" />

<main class="db-wrap">
    <h2 class="db-title">Dashboard — Ordens de Serviço</h2>

    <div class="filter-bar">
        <form method="get" id="filterForm">
            <div class="filter-row">
                <div class="filter-group">
                    <span class="filter-label">Período</span>
                    <select name="periodo" onchange="document.getElementById('filterForm').submit()">
                        <option value="todos" selected="@(Model.PeriodoSelecionado == "todos")">Todos</option>
                        <option value="mensal" selected="@(Model.PeriodoSelecionado == "mensal")">Mensal (30 dias)</option>
                        <option value="trimestral" selected="@(Model.PeriodoSelecionado == "trimestral")">Trimestral (90 dias)</option>
                        <option value="semestral" selected="@(Model.PeriodoSelecionado == "semestral")">Semestral (180 dias)</option>
                        <option value="anual" selected="@(Model.PeriodoSelecionado == "anual")">Anual (365 dias)</option>
                    </select>
                </div>
                <div class="filter-group">
                    <span class="filter-label">Status</span>
                    <select name="status" onchange="document.getElementById('filterForm').submit()">
                        <option value="">Todos</option>
                        <option value="Aberta" selected="@(Model.StatusSelecionado == "Aberta")">Aberta</option>
                        <option value="Em andamento" selected="@(Model.StatusSelecionado == "Em andamento")">Em andamento</option>
                        <option value="Concluída" selected="@(Model.StatusSelecionado == "Concluída")">Concluída</option>
                        <option value="Cancelada" selected="@(Model.StatusSelecionado == "Cancelada")">Cancelada</option>
                        <option value="Em pausa" selected="@(Model.StatusSelecionado == "Em pausa")">Em pausa</option>
                    </select>
                </div>
                <div class="filter-group">
                    <span class="filter-label">Prioridade</span>
                    <select name="prioridade" onchange="document.getElementById('filterForm').submit()">
                        <option value="">Todas</option>
                        <option value="Alta" selected="@(Model.PrioridadeSelecionada == "Alta")">Alta</option>
                        <option value="Média" selected="@(Model.PrioridadeSelecionada == "Média")">Média</option>
                        <option value="Baixa" selected="@(Model.PrioridadeSelecionada == "Baixa")">Baixa</option>
                    </select>
                </div>
                <div class="filter-group">
                    <span class="filter-label">Bloco</span>
                    <select name="bloco" onchange="document.getElementById('filterForm').submit()">
                        <option value="">Todos</option>
                        @foreach (var b in Model.Blocos)
                        {
                            <option value="@b" selected="@(b == Model.BlocoSelecionado)">@b</option>
                        }
                    </select>
                </div>
            </div>

            <div class="filter-row">
                <div class="filter-group">
                    <span class="filter-label">Solicitante</span>
                    <select name="solicitante" onchange="document.getElementById('filterForm').submit()">
                        <option value="">Todos</option>
                        @foreach (var s in Model.Solicitantes)
                        {
                            <option value="@s" selected="@(s == Model.SolicitanteSelecionado)">@s</option>
                        }
                    </select>
                </div>
                <div class="filter-group">
                    <span class="filter-label">Executor</span>
                    <select name="executor" onchange="document.getElementById('filterForm').submit()">
                        <option value="">Todos</option>
                        @foreach (var e in Model.Executores)
                        {
                            <option value="@e" selected="@(e == Model.ExecutorSelecionado)">@e</option>
                        }
                    </select>
                </div>
                <div class="filter-group">
                    <span class="filter-label">Data Inicial (De)</span>
                    <input type="date" name="dataDe" value="@Model.DataDe" onchange="document.getElementById('filterForm').submit()" />
                </div>
                <div class="filter-group">
                    <span class="filter-label">Data Final (Até)</span>
                    <input type="date" name="dataAte" value="@Model.DataAte" onchange="document.getElementById('filterForm').submit()" />
                </div>
            </div>

            @if (Model.FiltrosAtivos > 0)
            {
                <div style="display: flex; justify-content: flex-end; margin-top: 10px;">
                    <a href="@Url.Action(ViewContext.RouteData.Values["action"]?.ToString(), ViewContext.RouteData.Values["controller"]?.ToString())" class="btn-clear-filter">
                        Limpar Filtros
                    </a>
                </div>
            }
        </form>
    </div>

    <div id="active-tags" class="active-tags">
        @if (Model.PeriodoSelecionado != "todos")
        {
            <span class="filter-tag">Período ativo <a href="?@Html.Raw(JavaScriptQueryString("periodo"))">×</a></span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.StatusSelecionado))
        {
            <span class="filter-tag">Status: @Model.StatusSelecionado <a href="?@Html.Raw(JavaScriptQueryString("status"))">×</a></span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.PrioridadeSelecionada))
        {
            <span class="filter-tag">Prioridade: @Model.PrioridadeSelecionada <a href="?@Html.Raw(JavaScriptQueryString("prioridade"))">×</a></span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.BlocoSelecionado))
        {
            <span class="filter-tag">Bloco: @Model.BlocoSelecionado <a href="?@Html.Raw(JavaScriptQueryString("bloco"))">×</a></span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.SolicitanteSelecionado))
        {
            <span class="filter-tag">Sol: @Model.SolicitanteSelecionado <a href="?@Html.Raw(JavaScriptQueryString("solicitante"))">×</a></span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ExecutorSelecionado))
        {
            <span class="filter-tag">Exe: @Model.ExecutorSelecionado <a href="?@Html.Raw(JavaScriptQueryString("executor"))">×</a></span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.DataDe))
        {
            <span class="filter-tag">De: @Model.DataDe <a href="?@Html.Raw(JavaScriptQueryString("dataDe"))">×</a></span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.DataAte))
        {
            <span class="filter-tag">Até: @Model.DataAte <a href="?@Html.Raw(JavaScriptQueryString("dataAte"))">×</a></span>
        }
    </div>

    <div class="metric-grid">
        <div class="metric-card mc-total">
            <div class="mc-label">Total OS</div>
            <div class="mc-val">@Model.Total</div>
            <div class="mc-sub">*</div>
        </div>
        <div class="metric-card mc-abertas">
            <div class="mc-label">Abertas</div>
            <div class="mc-val">@Model.Abertas</div>
            <div class="mc-sub">@Model.PercentualAbertas</div>
        </div>
        <div class="metric-card mc-andamento">
            <div class="mc-label">Em andamento</div>
            <div class="mc-val">@Model.EmAndamento</div>
            <div class="mc-sub">@Model.PercentualEmAndamento</div>
        </div>
        <div class="metric-card mc-concluidas">
            <div class="mc-label">Concluídas</div>
            <div class="mc-val">@Model.Concluidas</div>
            <div class="mc-sub">@Model.PercentualConcluidas</div>
        </div>
        <div class="metric-card mc-canceladas">
            <div class="mc-label">Canceladas</div>
            <div class="mc-val">@Model.Canceladas</div>
            <div class="mc-sub">@Model.PercentualCanceladas</div>
        </div>
        <div class="metric-card mc-pausa">
            <div class="mc-label">Em pausa</div>
            <div class="mc-val">@Model.EmPausa</div>
            <div class="mc-sub">@Model.PercentualEmPausa</div>
        </div>
    </div>

    <div class="charts-grid">
        <div class="charts-card">
            <p class="chart-title">OS por status</p>
            <div style="height: 250px; position: relative;">
                <canvas id="graficoStatus"></canvas>
            </div>
        </div>
        <div class="charts-card">
            <p class="chart-title">OS por prioridade</p>
            <div style="height: 250px; position: relative;">
                <canvas id="graficoPrioridade"></canvas>
            </div>
        </div>
    </div>

    <div class="os-table-card" style="background: #fff; border-radius: 12px; border: 1px solid #eee; overflow: hidden;">
        <div style="padding: 1rem; border-bottom: 1px solid #eee; font-weight: 600; display: flex; justify-content: space-between;">
            <span>Ordens de serviço</span>
            <span style="background: #eee; padding: 2px 8px; border-radius: 4px; font-size: 12px;">@Model.TotalItens registros</span>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                <thead style="background: #f8f9fa; text-align: left;">
                    <tr>
                        <th style="padding: 12px;">ID</th>
                        <th style="padding: 12px;">Solicitante</th>
                        <th style="padding: 12px;">Executor</th>
                        <th style="padding: 12px;">Status</th>
                        <th style="padding: 12px;">Prioridade</th>
                        <th style="padding: 12px;">Bloco</th>
                        <th style="padding: 12px;">Data</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaOS == null || !Model.ListaOS.Any())
                    {
                        <tr><td colspan="7" style="padding: 2rem; text-align: center; color: #888;">Nenhuma OS encontrada.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model.ListaOS)
                        {
                            <tr>
                                <td style="padding: 12px; border-top: 1px solid #eee; font-family: monospace;">@item.idOrdemServico</td>
                                <td style="padding: 12px; border-top: 1px solid #eee;">@item.solicitante</td>
                                <td style="padding: 12px; border-top: 1px solid #eee;">@item.executor</td>
                                <td style="padding: 12px; border-top: 1px solid #eee;">
                                    <span class="
                                        @(item.status == "Aberta" ? "badge-aberta" :
                                                  item.status == "Em andamento" ? "badge-andamento" :
                                                  item.status == "Concluída" ? "badge-concluida" :
                                                  item.status == "Cancelada" ? "badge-cancelada" :
                                                  item.status == "Em pausa" ? "badge-pausa" :
                                                  "badge")
                                        ">
                                        @item.status
                                    </span>
                                </td>
                                <td style="padding: 12px; border-top: 1px solid #eee;">
                                    <span class="
                                        @(item.prioridade == "Baixa" ? "badge-prioridade-baixa" :
                                              item.prioridade == "Média" ? "badge-prioridade-media" :
                                              item.prioridade == "Alta" ? "badge-prioridade-alta" :
                                              "badge")
                                        ">
                                        @item.prioridade
                                    </span>
                                </td>
                                <td style="padding: 12px; border-top: 1px solid #eee;">@item.bloco</td>
                                <td style="padding: 12px; border-top: 1px solid #eee; color: #888;">@item.dataSolicitacao.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINAÇÃO AQUI -->
        @if (Model.TotalPaginas > 1)
        {
            <div class="paginacao">

                @if (Model.PaginaAtual > 1)
                {
                    <a href="?@MontarQuery(Model.PaginaAtual - 1)">
                        ← Anterior
                    </a>
                }

                <span>
                    Página @Model.PaginaAtual de @Model.TotalPaginas
                </span>

                @if (Model.PaginaAtual < Model.TotalPaginas)
                {

                    <a href="?@MontarQuery(Model.PaginaAtual + 1)">
                        Próxima →
                    </a>
                }

            </div>
        }

    </div>
</main>

@functions {
    public string JavaScriptQueryString(string keyToRemove)
    {
        var queryMap = Context.Request.Query.ToDictionary(x => x.Key, x => x.Value.ToString());
        queryMap.Remove(keyToRemove);
        return string.Join("&", queryMap.Select(x => $"{x.Key}={Uri.EscapeDataString(x.Value)}"));
    }

    public string MontarQuery(int pagina)
    {
        var query = Context.Request.Query
            .ToDictionary(x => x.Key, x => x.Value.ToString());

        query["pagina"] = pagina.ToString();

        return string.Join("&",
            query.Select(x =>
                $"{x.Key}={Uri.EscapeDataString(x.Value)}"));
    }
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
    new Chart(document.getElementById('graficoStatus'), {
    type: 'doughnut',
    data: {
    labels: [
    'Aberta',
    'Em andamento',
    'Concluída',
    'Cancelada',
    'Em pausa'
    ],
    datasets: [{
    data: [
    @Model.Abertas,
    @Model.EmAndamento,
    @Model.Concluidas,
    @Model.Canceladas,
    @Model.EmPausa
    ],
    backgroundColor: [
    '#6B7280', // Cinza
    '#EAB308', // Amarelo
    '#16A34A', // Verde
    '#DC2626', // Vermelho
    '#2563EB'  // Azul
    ],
    borderWidth: 0
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    cutout: '65%'
    }
    });

    new Chart(document.getElementById('graficoPrioridade'), {
    type: 'bar',
    data: {
    labels: ['Baixa', 'Média', 'Alta'],
    datasets: [{
    label: 'Quantidade',
    data: [@Model.PrioridadeBaixa,
    @Model.PrioridadeMedia,
    @Model.PrioridadeAlta],
    backgroundColor: ['#639922', '#EF9F27', '#A32D2D'],
    borderRadius: 5
    }]
    },
    options: { responsive: true, maintainAspectRatio: false }
    });
</script>
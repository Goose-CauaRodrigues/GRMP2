@model OrdemServicoViewModel

@{
    ViewData["Title"] = "Nova Ordem de Serviço";
}

<link rel="stylesheet" href="~/css/OsCriar.css" />

<div class="container-os">

    <div class="header-pagina">
        <div>
            <h1>Nova Ordem de Serviço</h1>
            <p>Registrar uma nova solicitação no sistema</p>
        </div>
        <a href="@Url.Action("InicioExibir", "Usuario")" class="btn-voltar">Voltar</a>
    </div>

    <form asp-action="Create" method="post" class="card-formulario">

        <div class="grupo-form">
            <label asp-for="Bloco">Bloco</label>
            <select asp-for="Bloco" id="bloco">
                <option value="">Selecione um bloco</option>
                <option value="1">Bloco A</option>
                <option value="2">Bloco B</option>
                <option value="3">Bloco C</option>
            </select>
        </div>

        <div class="grupo-form">
            <label asp-for="Local">Local</label>
            <select asp-for="Local" id="local" disabled>
                <option value="">Primeiro selecione um bloco</option>
            </select>
        </div>

        <div class="grupo-form">
            <label asp-for="Categoria">Categoria</label>
            <select asp-for="Categoria">
                <option value="">Selecione</option>
                <option value="Infraestrutura">Infraestrutura</option>
                <option value="Manutencao">Manutenção</option>
            </select>
        </div>

        <div class="grupo-form grupo-full">
            <label asp-for="DescricaoServico">Descrição do Problema</label>
            <textarea asp-for="DescricaoServico" rows="5" placeholder="Descreva o problema encontrado..."></textarea>
        </div>

        <div class="acoes-form">
            <button type="submit" class="btn-salvar">Criar Solicitação</button>
        </div>

    </form>
</div>
@model OrdemServicoViewModel
@using System.Data;

@{
    ViewData["Title"] = "Nova Ordem de Serviço";
}
@{
    Layout = null;
}

<link rel="stylesheet" href="~/css/OsCriar.css" />

<div class="container-os">

    <div class="header-pagina">
        <div>
            <h1>Nova Ordem de Serviço</h1>
            <p>Registrar uma nova solicitação no sistema</p>
        </div>

        <a href="@Url.Action("InicioExibir", "Usuario")" class="btn-voltar">
            Voltar
        </a>
    </div>

    <form asp-action="CriarOSProcessar" asp-controller="Usuario" method="post" class="card-formulario">

        <!-- BLOCO -->
        <div class="grupo-form">
            <label asp-for="Bloco">Bloco</label>

            <select asp-for="Bloco" id="bloco">
                <option value="">Selecione um bloco</option>

                @foreach (DataRow bloco in Model.DtBlocos.Rows)
                {
                    <option value="@bloco["idBloco"]">
                        @bloco["nome"]
                    </option>
                }
            </select>
        </div>

        <!-- LOCAL -->
        <div class="grupo-form">
            <label asp-for="Local">Local</label>

            <select asp-for="Local" id="local" disabled>
                <option value="">
                    Primeiro selecione um bloco
                </option>
            </select>
        </div>

        <!-- CATEGORIA -->
        <div class="grupo-form">
            <label asp-for="Categoria">Categoria</label>

            <select asp-for="Categoria" id="categoria">
                <option value="">Selecione</option>

                <option value="1">
                    Infraestrutura
                </option>

                <option value="2">
                    Manutenção
                </option>
            </select>
        </div>

        <!-- PATRIMÔNIO -->
        <div class="grupo-form"
             id="grupoPatrimonio"
             style="display: none;">

            <label asp-for="NumeroPatrimonio">
                Código do Ativo
            </label>

            <input type="text"
                   asp-for="NumeroPatrimonio"
                   placeholder="Digite o código do ativo" />
        </div>

        <!-- DESCRIÇÃO -->
        <div class="grupo-form grupo-full">
            <label asp-for="DescricaoServico">
                Descrição do Problema
            </label>

            <textarea asp-for="DescricaoServico"
                      rows="5"
                      placeholder="Descreva o problema encontrado...">
            </textarea>
        </div>

        <!-- BOTÃO -->
        <div class="acoes-form">
            <button type="submit" class="btn-salvar">
                Criar Solicitação
            </button>
        </div>

    </form>
</div>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        //-----------------------------------
        // ELEMENTOS
        //-----------------------------------

        const selectBloco = document.getElementById("bloco");
        const selectLocal = document.getElementById("local");

        const selectCategoria =
            document.getElementById("categoria");

        const grupoPatrimonio =
            document.getElementById("grupoPatrimonio");

        //-----------------------------------
        // BLOCO -> LOCAIS
        //-----------------------------------

        selectBloco.addEventListener("change", function () {

            let idBloco = this.value;

            selectLocal.innerHTML = "";

            //-----------------------------------
            // SEM BLOCO
            //-----------------------------------

            if (idBloco === "") {

                selectLocal.disabled = true;

                selectLocal.innerHTML =
                    '<option value="">Primeiro selecione um bloco</option>';

                return;
            }

            //-----------------------------------
            // BUSCAR LOCAIS
            //-----------------------------------

            fetch(`/Usuario/BuscarLocaisPorBloco?idBloco=${idBloco}`)

                .then(response => response.json())

                .then(data => {

                    selectLocal.disabled = false;

                    selectLocal.innerHTML =
                        '<option value="">Selecione um local</option>';

                    data.forEach(function (local) {


                        selectLocal.innerHTML +=
                            `<option value="${local.idLocal}">
                                ${local.nome}
                            </option>`;
                    });
                })

                .catch(error => {

                    console.error(error);

                    selectLocal.disabled = true;

                    selectLocal.innerHTML =
                        '<option value="">Erro ao carregar locais</option>';
                });
        });

        //-----------------------------------
        // CATEGORIA -> PATRIMÔNIO
        //-----------------------------------

        selectCategoria.addEventListener("change", function () {

            if (this.value === "2") {

                grupoPatrimonio.style.display = "flex";
            }
            else {

                grupoPatrimonio.style.display = "none";
            }
        });

    });

</script>